# Copy this file to .env and fill in real values. Never commit .env.

# Main application database (local PostgreSQL or Neon).
# Neon example: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/spendwise?sslmode=require
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/spendwise

# Separate database used ONLY by pytest. All tables in it are dropped and recreated on each run.
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/spendwise_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENVIRONMENT=development

# Phase 2 AI features (categorisation, insights, chat assistant, receipt scanning).
# Get a key at https://console.anthropic.com. Leave empty to switch AI features off.
ANTHROPIC_API_KEY=
# Claude model used for AI features.
AI_MODEL=claude-opus-5-5
