# Copy this file to .env and fill in real values. Never commit .env.

# Main application database (local PostgreSQL or Neon).
# Neon example: postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/spendwise?sslmode=require
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/spendwise

# Separate database used ONLY by pytest. All tables in it are dropped and recreated on each run.
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/spendwise_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENVIRONMENT=development

# Phase 2: category suggestions, quick add, insights and the assistant use SpendWise's own
# models and need no settings. Only receipt scanning needs an outside vision model:
# AI_PROVIDER = off (default, receipt scanning hidden), ollama (free, local) or anthropic (paid).
AI_PROVIDER=off

# Used when AI_PROVIDER=ollama (https://ollama.com). Download the vision model once:
#   ollama pull gemma3:4b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=300

# Used when AI_PROVIDER=anthropic. Get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
